# Africa's Talking API Credentials
# Get these from https://account.africastalking.com/apps/sandbox/settings/key

# For sandbox testing:
AT_USERNAME=sandbox
AT_API_KEY=YOUR_SANDBOX_API_KEY_HERE

# For production:
# AT_USERNAME=YOUR_PRODUCTION_USERNAME
# AT_API_KEY=YOUR_PRODUCTION_API_KEY
# AT_SENDER_ID=YOUR_SENDER_ID (optional)

# Upstash Redis (for Vercel deployment)
# Get these from Vercel > Storage > Create Database > Upstash Redis
# Or from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=your_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_redis_rest_token_here

# Vercel Cron Secret (for securing cron endpoints)
# Generate a random string: openssl rand -base64 32
CRON_SECRET=your_secure_random_string_here

# ngrok configuration (for local testing only)
# Get from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
